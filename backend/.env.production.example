# Production — скопируйте в .env на сервере (без коммита секретов)

APP_ENV=production
DEBUG=false
ALLOW_DIRECT_SUBSCRIPTION_CREATE=false
REQUIRE_PAYMENTS_READINESS=false
REQUIRE_S3_READINESS=false
SKIP_GOOGLE_ID_TOKEN_VERIFICATION=false

SECRET_KEY=CHANGE_ME_min_32_chars
DATABASE_URL=postgresql://user:pass@db-host:5432/haneat
REDIS_URL=redis://redis-host:6379/0
REDIS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
BOT_WEBHOOK_TIMEOUT_SECONDS=4.0
BOT_WEBHOOK_MAX_RETRIES=2
BOT_WEBHOOK_SIGN_WITH_SECRET=true
BOT_WEBHOOK_SIGNATURE_TTL_SECONDS=300
BOT_WEBHOOK_QUEUE_ENABLED=true
BOT_WEBHOOK_QUEUE_POLL_SECONDS=1.0
BOT_WEBHOOK_MAX_PER_BOT_PER_MINUTE=120
BOT_WEBHOOK_DELIVERY_MAX_ATTEMPTS=5
BOT_WEBHOOK_AUTO_DISABLE_AFTER_FAIL_STREAK=10
BOT_WEBHOOK_FAIL_STREAK_TTL_SECONDS=3600
BOT_WEBHOOK_ALERT_DEAD_DEPTH=20
BOT_WEBHOOK_ALERT_AUTO_DISABLED_24H=1
BOT_WEBHOOK_ALERT_FAILS_1H=30
BOT_WEBHOOK_ALERT_FAIL_RATE_PERCENT_1H=20
BOT_WEBHOOK_ALERT_MIN_ATTEMPTS_1H=20
BOT_WEBHOOK_ALERT_DROPPED_TOTAL=10
BOT_WEBHOOK_ALERT_THROTTLED_TOTAL=50
BOT_WEBHOOK_OP_MAX_REQUEUE_LIMIT=500
BOT_WEBHOOK_OP_MAX_PROMOTE_LIMIT=500
BOT_WEBHOOK_OP_MAX_RUNBOOK_REQUEUE_LIMIT=500
BOT_WEBHOOK_OP_MAX_RUNBOOK_PROMOTE_LIMIT=500

API_PUBLIC_BASE_URL=https://api.haneat.app
ALLOWED_ORIGINS=https://haneat.app,https://www.haneat.app
FRONTEND_URL=https://haneat.app
MINIAPP_BLOCK_PRIVATE_HOSTS=true
MINIAPP_REQUIRE_APPROVED_FOR_USE=true

GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# Яндекс ID — https://oauth.yandex.ru (redirect: haneat://oauth/yandex)
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

SPOONACULAR_API_KEY=
# Tenor GIF catalog (Google Cloud API key). Empty = GIF search/featured disabled.
TENOR_API_KEY=
TENOR_CLIENT_KEY=hanwe
OPENAI_API_KEY=
OPENAI_FOOD_SCAN_MODEL=gpt-4.1-nano
ENABLE_PRE_MODERATION=false
ENABLE_AI_MODERATION=true

YOOKASSA_ENABLED=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SIGNATURE_REQUIRED=true
# sbp — только СБП; any — все способы на странице ЮKassa
YOOKASSA_PAYMENT_METHOD=sbp
# false до релиза: только разовая оплата СБП; true — после подключения рекуррента в ЮKassa
YOOKASSA_SBP_RECURRING_ENABLED=false

# Версия privacy + terms; при смене пользователи увидят экран согласия
LEGAL_DOCUMENT_VERSION=2026-06-03

# Timeweb Object Storage: ключи из панели хранилища (не из корневого .env Flutter)
S3_BUCKET=haneat-media
S3_REGION=ru-1
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Пока S3 не настроен — оставьте ключи пустыми: загрузки пойдут через API
CDN_URL=https://s3.twcstorage.ru/haneat-media

FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_PATH=/etc/haneat/firebase-credentials.json
FIREBASE_PROJECT_ID=

# iOS CallKit (PushKit VoIP) — Apple Auth Key .p8 with Push Notifications.
# Topic becomes "{APNS_BUNDLE_ID}.voip". Without these, killed-state iOS won't ring.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.haneat.app
# PEM body (escape newlines as \n) OR absolute path:
APNS_AUTH_KEY=
APNS_AUTH_KEY_PATH=/etc/haneat/AuthKey_XXXXX.p8
# true for Xcode/dev builds; false for App Store / TestFlight production
APNS_USE_SANDBOX=false

STRIPE_ENABLED=false

# Email: регистрация, подтверждение, сброс/смена пароля
REQUIRE_EMAIL_VERIFICATION=true
AUTH_LINK_BASE_URL=haneat://auth
# Resend (рекомендуется с VPS)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxx
EMAIL_FROM_NAME=HAN Eat
# До верификации домена — только на email владельца Resend-аккаунта:
# EMAIL_FROM=onboarding@resend.dev
# После верификации haneat.app в Resend (см. docs/EMAIL_AUTH_SETUP.md §8):
EMAIL_FROM=noreply@haneat.app
RESEND_DOMAIN_VERIFIED=true

# Яндекс SMTP (не работает с VPS — только если EMAIL_PROVIDER=smtp)
# EMAIL_SMTP_HOST=smtp.yandex.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_USE_TLS=false
# EMAIL_SMTP_USE_SSL=true
